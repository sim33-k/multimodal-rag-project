# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional model overrides. The defaults below are what the code uses.
#
# Free-tier daily quotas differ sharply by model, and they are per-model. The
# flagship flash model writes the best answers but allows only ~20 requests a day,
# so routing - which runs on every query - uses a lite model with a much larger
# allowance, keeping the flagship budget for the answers themselves.
#
# Avoid pinned names like gemini-2.0-flash: several report a zero free-tier quota,
# and older versions are closed to new API keys. The *-latest aliases keep working.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_ROUTER_MODEL=gemini-flash-lite-latest

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://sltourism_user:devpassword@localhost:5432/sltourism

# Only needed if the frontend is opened from disk rather than served at /ui
API_BASE_URL=http://localhost:8000
